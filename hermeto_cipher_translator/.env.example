# Configuração das APIs de IA Vision
# Adicione suas chaves de API aqui

# OpenAI GPT-4 Vision
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Google Gemini Vision  
# Obtenha em: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_key_here

# Anthropic Claude (quando disponível)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Como usar:
# 1. Substitua "your_*_key_here" pelas suas chaves reais
# 2. Execute: export $(cat .env | xargs) 
# 3. Ou carregue no seu shell: source .env